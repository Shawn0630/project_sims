# Backend configuration — copy to .env (gitignored) or export in the shell.
# Shell environment variables take precedence over this file.

# Port the API listens on (default 8787).
PORT=8787

# LLM eval provider: any OpenAI-compatible /chat/completions endpoint.
# Leave LLM_API_KEY unset to run fully offline — evaluation then falls back
# to the deterministic ScriptedDriver and everything still works.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
